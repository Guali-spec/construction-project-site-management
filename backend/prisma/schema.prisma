generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

/**
 * Rôles globaux (RBAC global)
 * Basé sur le cahier des charges : Super Admin, Admin Entreprise, Chef de Projet,
 * Superviseur, Comptable, Consultant. :contentReference[oaicite:2]{index=2}
 */
enum GlobalRole {
  PENDING
  SUPER_ADMIN
  ADMIN_ENTREPRISE
  CHEF_PROJET
  SUPERVISEUR
  COMPTABLE
  CONSULTANT
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  SUPERVISOR
  WORKER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportType {
  PROJECT_SUMMARY
  FINANCIAL
  ATTENDANCE
  PROGRESS
}
model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  projects  Project[]

  @@map("companies")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatar       String?
  role         GlobalRole @default(PENDING)
  requestedRole GlobalRole?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  companyId    String?

  // Relations
  refreshTokens RefreshToken[]
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdProjects Project[]       @relation("ProjectCreatedBy")
  memberships     ProjectMember[]
  activityLogs    ActivityLog[]
  createdExpenses Expense[]
  createdPhotos   ProgressPhoto[]
  createdReports  Report[]

  @@index([role])
  @@index([companyId])
  @@index([deletedAt])
  @@map("users")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  status      ProjectStatus @default(PLANNED)
  budget      Decimal?      @db.Decimal(14, 2)

  createdById String
  createdBy   User          @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  // Relations
  members     ProjectMember[]
  phases      Phase[]
  workers     Worker[]
  attendances Attendance[]
  materials   Material[]
  expenses    Expense[]
  photos      ProgressPhoto[]
  reports     Report[]
  activityLogs ActivityLog[]

  @@index([status])
  @@index([createdById])
  @@index([companyId])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectMember {
  id         String            @id @default(uuid())
  projectId  String
  userId     String
  role       ProjectMemberRole
  assignedAt DateTime          @default(now())
  deletedAt  DateTime?

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, deletedAt])
  @@index([userId])
  @@index([projectId])
  @@index([deletedAt])
  @@map("project_members")
}

model Phase {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  order       Int
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lots        Lot[]

  @@index([projectId])
  @@index([order])
  @@index([deletedAt])
  @@map("phases")
}

model Lot {
  id          String   @id @default(uuid())
  phaseId     String
  name        String
  description String?
  order       Int
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  phase       Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([phaseId])
  @@index([order])
  @@index([deletedAt])
  @@map("lots")
}

model Task {
  id              String       @id @default(uuid())
  lotId           String
  name            String
  description     String?
  status          TaskStatus   @default(TODO)
  progress        Int          @default(0)
  priority        TaskPriority @default(MEDIUM)
  estimatedCost   Decimal?     @db.Decimal(14, 2)
  actualCost      Decimal?     @db.Decimal(14, 2)
  assignedWorkerId String?
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  lot             Lot          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  assignedWorker  Worker?      @relation(fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  photos          ProgressPhoto[]

  @@index([lotId])
  @@index([assignedWorkerId])
  @@index([status])
  @@index([deletedAt])
  @@map("tasks")
}

model Worker {
  id         String   @id @default(uuid())
  projectId  String
  firstName  String
  lastName   String
  trade      String?
  phone      String?
  dailyRate  Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks      Task[]
  attendances Attendance[]

  @@index([projectId])
  @@index([deletedAt])
  @@map("workers")
}

model Attendance {
  id        String   @id @default(uuid())
  projectId String
  workerId  String
  date      DateTime
  present   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workerId])
  @@index([date])
  @@index([deletedAt])
  @@map("attendances")
}

model Material {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  unit        String?
  quantity    Int      @default(0)
  unitCost    Decimal? @db.Decimal(12, 2)
  totalCost   Decimal? @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([deletedAt])
  @@map("materials")
}

model Expense {
  id          String        @id @default(uuid())
  projectId   String
  amount      Decimal       @db.Decimal(14, 2)
  category    String
  description String?
  status      ExpenseStatus @default(PENDING)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@index([deletedAt])
  @@map("expenses")
}

model ProgressPhoto {
  id        String   @id @default(uuid())
  projectId String
  taskId    String?
  url       String
  caption   String?
  createdById String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([taskId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("progress_photos")
}

model Report {
  id        String     @id @default(uuid())
  projectId String
  type      ReportType
  payload   Json?
  createdById String
  createdAt DateTime   @default(now())
  deletedAt DateTime?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([type])
  @@index([createdById])
  @@index([deletedAt])
  @@map("reports")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  projectId String?

  action    String
  entityType String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  deletedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([entityType])
  @@index([deletedAt])
  @@map("activity_logs")
}


model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  jti         String   @unique
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  replacedBy  String?  // id du nouveau refresh token (rotation)
  deletedAt   DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("refresh_tokens")
}
